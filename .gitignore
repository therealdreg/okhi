# okhi build output. No output of the five release targets is versioned, but git
# tracks firmware/leonardo_uart2keyboard/build and several build folders in stuff/.
#
# The ESP images are built with firmware/<variant>/esp/src/wifi_secret.h when it is
# present, so a development build carries a real SSID and password inside okhi.bin
# and okhi.elf. Keeping the images out of the index means the credentials cannot be
# committed by accident, whatever a build script does. So a release starts from
# source: make_release.py builds the five targets and packages them. See
# "Generating a New Release" in README.md.

# The ESP-IDF config. idf.py regenerates it from sdkconfig.defaults when it is
# missing, byte-identical (verified), so versioning it only adds noise.
# sdkconfig.defaults and partitions.csv are the source of truth and stay in, as do
# the sdkconfig.ci* files. sdkconfig.old is idf.py's backup copy of sdkconfig.
firmware/*/esp/sdkconfig
firmware/*/esp/sdkconfig.old

# Every build tree, in full, whatever it is called (build/, build_debug/, ...).
firmware/*/esp/build*/
firmware/*/rp/build*/
firmware/uart_bridge/build*/

# Developer WiFi credentials: never commit them. The tracked wifi_client.h holds
# none and includes wifi_secret.h when it exists. wifi_secret.h holds the SSID and
# password under a separate name, which has never been in the index, so it cannot
# be committed by accident.
firmware/*/esp/src/wifi_secret.h

# Release output. make_release.py writes release/<yyyyMMddHHmmss>/ with the built
# images and a copy of stuff/last_esptool, which is hundreds of megabytes. None of
# it belongs in the history: it can all be rebuilt from the tree, and a release
# built for testing carries whatever was in wifi_secret.h at the time. Ignoring the
# whole directory means no release can be committed by accident, whatever its name.
/release/

# Older releases sit in a bare timestamp folder at the repo root. Ignored so an
# existing working copy does not show them as untracked.
/20????????????/

# Python bytecode cache. The interpreter writes it next to each module a script
# imports (make_release.py or firmware/leonardo_uart2keyboard/build.py when another
# script imports them), so it turns up as untracked noise and could be committed by
# accident. Nothing in it is useful: the next import rebuilds it from the .py.
__pycache__/
*.pyc

# okhi-kbd's chip readback: build.py --flash writes it on every flash to verify the
# write. It is a dump of one chip, not a build output anyone needs.
firmware/leonardo_uart2keyboard/build/readback.hex

# Side outputs of webgen.js: the page as C arrays (webuff*.txt) and a copy of the gzip
# it embeds (index.orig.gz), rewritten next to index.html on every run. The firmware
# takes firmware/<variant>/esp/main/index.html.gz and nothing reads these.
/webusb/webuff*.txt
/webps2/webuff*.txt
/webusb/index.orig.gz
/webps2/index.orig.gz
