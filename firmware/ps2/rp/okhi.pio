; okhi.c loads its four programs in a fixed order, so each one gets the same PIO, SM and offset
; on every boot, to avoid mental uncertainty when solving problems and knowing where things are.

; PS/2 protocol reference: Adam Chapweske's writeup, which was at computer-engineering.org.
; stuff/PS2_Keyboard.pdf is a 2007 printout of its protocol and keyboard pages.
;
; CLOCK and DATA are open collector with a pull-up to +5 V: either side can only pull a line
; low, and a released line goes back high.
;
; In a device-to-host frame the host reads DATA on the falling edge of CLOCK (DATA is valid while
; CLOCK is low). In a host-to-device frame the device reads DATA on the rising edge (valid while
; CLOCK is high).
;
; CLOCK runs at 10 to 16.7 kHz, so it is high for 30 to 50 us and low for 30 to 50 us. A bit is
; read in the middle of its cell, 15 to 25 us after the clock edge. The device always generates
; the clock, and the host can inhibit the bus at any time.
;
; Bus states, from the two line levels:
;   DATA high, CLOCK high: idle.
;   DATA high, CLOCK low:  communication inhibited (the host holds the bus).
;   DATA low,  CLOCK high: host Request-to-Send (RTS).
;
; A frame carries one byte in 11 or 12 bits: a start bit (0), 8 data bits LSB first, an odd
; parity bit, a stop bit (1) and, on host-to-device frames only, an ACK bit that the device
; drives.
;
; In a device-to-host frame a DATA transition comes at least 5 us after a rising clock edge, and
; at least 5 us and at most 25 us before the falling edge.
;
; The host inhibits by pulling CLOCK low for at least 100 us (IBM's PS/2 and PC AT technical
; references ask only for more than 60 us before the host sends). Inhibited before the 11th
; clock, the device aborts and sends the whole chunk again (make code, break code, device ID,
; mouse packet) once the host releases CLOCK: a keyboard cut in the second byte of a two-byte
; break code sends both bytes again. Inhibited before the first falling edge or after the last
; one, the device need not send anything again, and it buffers new data until the host releases
; CLOCK. A keyboard buffers 16 bytes, then ignores keystrokes until there is room.
;
; A host-to-device transfer (the device checks for an RTS at least every 10 ms):
;   1)  The host pulls CLOCK low for at least 100 us (inhibit).
;   2)  It pulls DATA low, the start bit: Request-to-Send.
;   3)  It releases CLOCK.
;   4)  It waits for the device to pull CLOCK low.
;   5)  It sets DATA to the first data bit.
;   6)  It waits for the device to release CLOCK.
;   7)  It waits for the device to pull CLOCK low.
;   8)  Steps 5 to 7 repeat for the other seven data bits and the parity bit.
;   9)  It releases DATA.
;   10) It waits for the device to pull DATA low (the ACK).
;   11) It waits for the device to pull CLOCK low.
;   12) It waits for the device to release DATA and CLOCK (idle).

; Why the ISR is cleared, and where the captured byte ends up
;
; Do not remove a 'mov isr, null' that looks unnecessary. inhibited_signal never pushes, so only
; its line 00 clears the ISR before line 07 samples DATA into it, and 'jmp !y' tests all 32 bits
; that 'mov y, isr' copies: without the clear, the 1 sampled at a release with no RTS stays in
; the ISR and the next RTS raises a false IRQ1. core0 can rewrite a capturer's PC at any moment to
; abort a capture, and the capturer's clear keeps the cut frame's bits out of the next FIFO
; word. The eight 'in pins, 1' before each push refill bits [31:24] anyway, so without the clear
; the stale bits would reach only bits [23:0], which okhi.c never reads. With autopush the logged
; byte would depend on the clear, because 'mov isr, null' also zeroes the input shift counter.
;
; PS/2 sends LSB first and both capturers shift the ISR right, so after eight samples the byte
; sits in bits [31:24] in the right bit order. okhi.c reads that top byte of the FIFO word
; directly, *((io_rw_8 *)&pio->rxf[sm] + 3) on the little-endian RP2040. An 'in null, 24' before
; the push would move the byte to bits [7:0], at the cost of one more PIO instruction.

; PIO0: inhibited_signal and device_to_host

.program inhibited_signal
; PIO0 SM0, must run at 1 MHz (1 us per cycle).
;
; Watches for the host inhibiting the bus (CLOCK low, whatever DATA does), then tells core0
; whether the host followed with a Request-to-Send (DATA low) or not.
;
; Lines 02 and 03 read CLOCK 1 us apart and line 04 reads nothing, so the 62 reads of the 31
; passes come alternately 1 and 2 us apart and span 91 us: IRQ0 needs CLOCK low for 91 to 93 us,
; depending on where the falling edge lands. A high blip restarts the window only if a read
; lands on it, which is certain only for a blip of 2 us or more.
;
; Chapweske gives at least 100 us for an inhibit. The window is shorter on purpose, because some
; PS/2 to USB adapters inhibit for a little less, and it stays above a clock-low half cycle,
; which lasts at most 50 us. IBM's references ask the host only for more than 60 us before it
; sends, and an inhibit shorter than 91 us never trips this window.
;
; IRQs, handled by pio0_irq in okhi.c:
;   IRQ0: inhibit detected.
;   IRQ1: the inhibit ended without an RTS (the host released CLOCK with DATA high).
;
; Set up in okhi.c:
;   FIFO_JOIN_RX: RX FIFO 8 words deep, no TX FIFO.
;   IN pin 0:     DAT
;   IN pin 1:     CLOCK
;   JMP pin:      CLOCK ('jmp pin' jumps when CLOCK is high)
;   Shift:        the SDK default, ISR shifts right, no autopush.
.wrap_target
restart:
    mov isr, null                   ; 00 Clear the ISR, so Y at line 08 holds only the bit of line 07
wait_for_inhibited:
    set x, 30                       ; 01 31 passes (x = 30..0) of 3 cycles
check_inhibited:
    jmp pin wait_for_inhibited      ; 02 CLOCK high: not inhibited, reload the counter
    jmp pin wait_for_inhibited      ; 03 Read CLOCK again, 1 us after line 02
    jmp x-- check_inhibited         ; 04 CLOCK still low: next pass until X runs out
    irq nowait 0                    ; 05 CLOCK low at all 62 reads: IRQ0, inhibit
    wait 1 pin 1                    ; 06 Wait for the host to release CLOCK
    in pins, 1                      ; 07 Sample DATA just after the release
    mov y, isr                      ; 08 Y = that DATA bit
    jmp !y, restart                 ; 09 DATA low: an RTS, restart with no IRQ
    irq nowait 1                    ; 10 DATA high: released with no RTS, IRQ1
.wrap

.program device_to_host
; PIO0 SM1, must run at about 133.6 kHz (7.485 us per cycle): 8 cycles per PS/2 clock at its
; fastest, 16.7 kHz. On device-to-host frames DATA is valid while CLOCK is low, so every bit is
; sampled after a falling edge.
;
; Captures one byte the device (keyboard or mouse) sends to the host: it waits for core0 to arm
; it, skips the start bit, samples the 8 data bits and pushes them, then steps over the parity
; and stop bits without storing them.
;
; AUX_D2H_JMP_GPIO is the arm switch, not the PS/2 clock: core0 drives it high to park this
; program at line 00 and low to let a capture start (stop_device_to_host_sm and
; start_device_to_host_sm in okhi.c).
;
; core0 restarts this SM when the host inhibits the bus, when it releases it without an RTS and
; when the bus goes idle (the IRQs of inhibited_signal and idle_signal), because some PS/2 to USB
; adapters send glitches and odd waveforms between valid packets. A restart before line 11 keeps
; a cut byte out of the FIFO, and line 01 clears the ISR because a restart can land on any line
; (see the ISR note above).
;
; Do not move the push or switch to autopush without checking what it changes: its position has
; been validated on many real adapters. The waits and delays that look idle are deliberate: they
; give core0 time to restart this SM before a wrong byte is pushed.
;
; Set up in okhi.c:
;   FIFO_JOIN_RX: RX FIFO 8 words deep, no TX FIFO.
;   IN pin 0:     DAT
;   IN pin 1:     CLOCK
;   JMP pin:      AUX_D2H_JMP_GPIO (high parks or aborts, low captures)
;   Shift:        ISR shifts right, no autopush.
.wrap_target
wait_for_start_signal:
    jmp pin wait_for_start_signal       ; 00 Parked while AUX_D2H_JMP_GPIO is high, falls through when low
    mov isr, null                       ; 01 Clear the ISR before a new capture
skip_start_bit:
    wait 0 pin 1                        ; 02 CLOCK low: the start bit
    wait 1 pin 1                        ; 03 CLOCK high: start bit skipped
proceed_to_capture:
    set x, 7                            ; 04 8 data bits (x = 7..0)
capture_8_bits_loop:
    wait 0 pin 1 [1]                    ; 05 Falling edge, then 1 cycle more to settle in the low cell
    in pins, 1                          ; 06 Sample one DATA bit into the ISR (LSB first, shift right)
    wait 1 pin 1 [1]                    ; 07 Rising edge (end of the bit cell), then 1 cycle to debounce
    jmp x-- capture_8_bits_loop         ; 08 Until all 8 data bits are in
skip_parity_and_stop_bits:
    wait 0 pin 1 [1]                    ; 09 Falling edge of the parity bit (not stored)
    jmp pin wait_for_start_signal [1]   ; 10 Abort hook: if core0 has raised AUX_D2H_JMP_GPIO, back to
                                        ;    line 00 with nothing pushed
    push noblock                        ; 11 Push the 8 bits to the RX FIFO (noblock: the SM never stalls)
    wait 1 pin 1                        ; 12 Rising edge of the parity bit
    wait 0 pin 1 [1]                    ; 13 Falling edge of the stop bit
    wait 1 pin 1                        ; 14 Rising edge of the stop bit: frame done
.wrap

; PIO1: host_to_device and idle_signal

.program host_to_device
; PIO1 SM0, must run at about 133.6 kHz (7.485 us per cycle), like device_to_host. On
; host-to-device frames the host changes DATA while CLOCK is low and the device reads it on the
; rising edge, so every data bit is sampled while CLOCK is high. The ACK, which the device
; drives, is the exception (line 15).
;
; Captures one byte the host sends to the device. A host transfer always opens with an inhibit
; (CLOCK held low), so this program waits for one, skips the start bit, samples the 8 data bits,
; pushes them and steps over parity and stop.
;
; The inhibit gate (lines 01 to 03) reads CLOCK at line 02, once every 2 cycles (15 us), and
; needs 6 low reads in a row, which span 10 cycles. A CLOCK low passes from 74.9 us when the
; falling edge lands just before a read, and always from 89.8 us (12 cycles). The gate is shorter
; than Chapweske's 100 us for the same reason as inhibited_signal: it stays above a clock-low
; half cycle (50 us at most). A low too short for inhibited_signal (91 to 93 us) can pass it.
;
; core0 restarts this SM when an inhibit ends without an RTS and when the bus goes idle (pio0_irq
; and pio1_irq in okhi.c). The ISR clear and the waits are there for the same reasons as in
; device_to_host. Do not move the push or enable autopush without checking what it changes.
;
; Set up in okhi.c:
;   FIFO_JOIN_RX: RX FIFO 8 words deep, no TX FIFO.
;   IN pin 0:     DAT
;   IN pin 1:     CLOCK
;   JMP pin:      CLOCK ('jmp pin' jumps when CLOCK is high)
;   Shift:        ISR shifts right, no autopush.
;   Wrap:         device_to_host's getter, so the wrap top is offset + 14 and line 15 never runs.
.wrap_target
    mov isr, null                      ; 00 Clear the ISR before a new capture
wait_for_inhibition:
    set x, 5                           ; 01 6 low reads (x = 5..0), one per 2-cycle pass
check_inhibition_loop:
    jmp pin wait_for_inhibition        ; 02 CLOCK high: not inhibited, reload the counter
    jmp x--, check_inhibition_loop     ; 03 CLOCK low: next read, until X runs out and the gate passes
skip_start_bit:
    wait 1 pin 1                       ; 04 The host releases CLOCK (with DATA low, the start bit)
    wait 0 pin 1                       ; 05 The device's first falling edge: start bit skipped
proceed_to_capture:
    set x, 7                           ; 06 8 data bits (x = 7..0)
capture_8_bits_loop:
    wait 1 pin 1 [1]                   ; 07 Rising edge, then 1 cycle more to settle in the high cell
    in pins, 1                         ; 08 Sample one DATA bit into the ISR (LSB first, shift right)
    wait 0 pin 1 [1]                   ; 09 Falling edge (end of the bit cell), then 1 cycle to debounce
    jmp x-- capture_8_bits_loop        ; 10 Until all 8 data bits are in
skip_parity_and_stop_bits:
    wait 1 pin 1 [1]                   ; 11 Rising edge of the parity bit (not stored)
    push noblock                       ; 12 Push the 8 bits to the RX FIFO (noblock: the SM never stalls)
    wait 0 pin 1                       ; 13 Falling edge after the parity bit
    wait 1 pin 1 [1]                   ; 14 Rising edge of the stop bit
skip_ack_bit:
    wait 0 pin 1 [1]                   ; 15 Falling edge of the ACK clock (never runs with okhi.c's wrap)
    ; The host drives the first 11 bits and changes DATA while CLOCK is low, so they are read on
    ; the rising edge. The device drives the ACK and changes DATA while CLOCK is high, so the ACK
    ; is read while CLOCK is low, after the 11th falling edge. This program does not keep it. To
    ; capture it (worked out from the code, the RP2040 datasheet and a cycle model, not run on the
    ; bench): keep line 14, add 'in pins, 1' and 'push noblock' after line 15, set the SM up in
    ; okhi.c with host_to_device_program_get_default_config() so the wrap reaches them, and make
    ; the main loop read the second FIFO word of each frame as the ACK instead of logging it as an
    ; H byte.
.wrap

.program idle_signal
; PIO1 SM1, must run at 1 MHz (1 us per cycle).
;
; Detects the bus idle (CLOCK and DATA both high) long enough to be sure it is quiet, then
; raises IRQ0 so core0 can arm device_to_host and restart host_to_device.
;
; The window is 31 passes (x = 30..0) of 4 cycles at 1 MHz, about 124 us: more than twice the
; longest clock-high half cycle (50 us), so a short high pulse on CLOCK or a gap inside a frame
; is never taken for idle. Line 01 reads both lines once per pass, so a low pulse shorter than
; 4 us can fall between two reads.
;
; IRQ0, handled by pio1_irq in okhi.c: idle.
;
; Set up in okhi.c:
;   FIFO_JOIN_RX: RX FIFO 8 words deep, no TX FIFO.
;   IN pin 0:     DAT
;   IN pin 1:     CLOCK
;   JMP pin:      CLOCK (this program never tests it)
;   Shift:        the SDK default, the OSR shifts right, so line 02 takes bits 1:0.
.wrap_target
wait_for_idle:
    set x, 30                           ; 00 31 passes (x = 30..0)
check_idle_loop:
    mov osr, !pins                      ; 01 OSR = the pins from DAT up, inverted (both lines high give 0s)
    out y, 2                            ; 02 Y = bits 1:0 of the OSR, the inverted DAT and CLOCK
    jmp !y, next_idle_check             ; 03 Y == 0: both lines high, keep counting
not_idle_detected:
    jmp wait_for_idle                   ; 04 A line is low: not idle, start over
next_idle_check:
    jmp x--, check_idle_loop            ; 05 Next pass until X runs out
idle_detected:
    irq nowait 0                        ; 06 Both lines high at all 31 reads: IRQ0, idle
.wrap                                   ; Back to 00: a long idle raises IRQ0 again every 126 us

; Auxiliary programs: okhi.c loads none of them. They are building blocks for bring-up, bus
; debugging and measuring the adapter glitches of the README's PS/2 developer notes: one adapter
; inhibits the bus (CLOCK low, DATA high) for about 8 ms of every 16.7 ms, another sends 1.8 us
; low pulses on CLOCK, and a pulse of about 8 us can appear on CLOCK before a real packet.

.program two_pin_mirror_reverse_inverter
; Runs at the highest practical frequency. Reads DAT (IN pin 0) and CLOCK (IN pin 1) and drives
; them out inverted and swapped:
;   OUT pin 0: CLOCK, inverted
;   OUT pin 1: DAT, inverted
; No autopush: use the SDK default shift settings (the ISR shifts right).
.wrap_target
    in pins, 2            ; 00 Sample both input pins into the top of the ISR
    mov y, ::isr          ; 01 Y = the ISR bit-reversed ('::'), which swaps the two pins
    mov pins, !y          ; 02 Drive the output pins with Y inverted
.wrap

.program two_pin_inverter
; Runs at the highest practical frequency. Reads DAT (IN pin 0) and CLOCK (IN pin 1) and drives
; them out inverted, in the same order:
;   OUT pin 0: DAT, inverted
;   OUT pin 1: CLOCK, inverted
.wrap_target
    mov pins, !pins       ; 00 Read both pins and drive them straight out, inverted
.wrap

.program two_pin_mirror
; Runs at the highest practical frequency. Copies DAT (IN pin 0) and CLOCK (IN pin 1) to the
; output pins unchanged:
;   OUT pin 0: DAT
;   OUT pin 1: CLOCK
.wrap_target
    mov pins, pins       ; 00 Read both pins and drive the same levels straight out
.wrap

.program two_pin_reverse
; Runs at the highest practical frequency. Reads DAT (IN pin 0) and CLOCK (IN pin 1) and drives
; them out swapped, levels unchanged:
;   OUT pin 0: CLOCK
;   OUT pin 1: DAT
; No autopush: use the SDK default shift settings (the ISR shifts right).
.wrap_target
    in pins, 2            ; 00 Sample both input pins into the top of the ISR
    mov pins, ::isr       ; 01 Drive the output pins with the ISR bit-reversed, which swaps the pins
.wrap

.program glitch_det_fast_rise
; Must run at 8 MHz (0.125 us per instruction).
;
; Flags a short CLOCK low: from a falling edge, it pushes X if CLOCK rises again within 8 us, the
; window of 32 passes of 2 instructions (64 * 0.125 us = 8 us).
;
;   Normal clock (no glitch):
;        ___          _________          ________
; CLOCK:    |________|         |________|        |________
;
;   With a short glitch:
;        ___          __  _____          _________
; CLOCK:    |________|  ||     |________|         |________
;                        ^
;                       a low pulse shorter than 8 us
;
; The pushed X also says when the rise came, about (31 - X) * 0.25 us after the fall: a coarse
; timer for very short pulses.
;
; Autopush on, 32-bit threshold.
; IN pin 0: CLOCK
; JMP pin:  CLOCK
.wrap_target
init_detection:
    set x, 31                 ; 00 32 passes (x = 31..0)
    wait 1 pin, 0             ; 01 CLOCK high first, so the next wait sees a real falling edge
    wait 0 pin, 0             ; 02 CLOCK low: the falling edge starts the window
check_for_glitch:
    jmp pin, glitch_detected  ; 03 CLOCK high again already: an early rise, the glitch
    jmp x--, check_for_glitch ; 04 Still low: next pass until X runs out
    jmp init_detection        ; 05 No early rise in the window: a normal pulse, start over
glitch_detected:
    in x, 32                  ; 06 X into the ISR; autopush sends it to the RX FIFO
.wrap

.program glitch_det_fast_fall
; Must run at 8 MHz (0.125 us per instruction).
;
; The same for the other transition: from a rising edge, it pushes X if CLOCK falls again within
; the 8 us window.
;
;   Normal clock (no glitch):
;        ___          _________          ________
; CLOCK:    |________|         |________|        |________
;
;   With a short glitch:
;        ___          _________          _________
; CLOCK:    |___||___|         |________|         |________
;                ^
;              a high pulse shorter than 8 us
;
; As in glitch_det_fast_rise, the pushed X says when the fall came.
;
; Autopush on, 32-bit threshold.
; IN pin 0: CLOCK
; JMP pin:  CLOCK
.wrap_target
init_detection:
    set x, 31                           ; 00 32 passes (x = 31..0)
    wait 0 pin, 0                       ; 01 CLOCK low first, so the next wait sees a real rising edge
    wait 1 pin, 0                       ; 02 CLOCK high: the rising edge starts the window
check_for_glitch:
    jmp pin, no_glitch_detected         ; 03 CLOCK still high: no fall yet, go count a pass
glitch_detected:
    in x, 32                            ; 04 CLOCK fell early: X into the ISR, autopush to the RX FIFO
    jmp init_detection                  ; 05 Start over
no_glitch_detected:
    jmp x--, check_for_glitch           ; 06 Next pass; when X runs out the wrap starts over (no glitch)
.wrap

.program rise_counter
; Must run at 125 MHz (8 ns per instruction).
;
; Times a CLOCK low: from a falling edge to the next rising edge, X counts down from 0xFFFFFFFF
; once per 2-instruction pass (16 ns), then X is pushed. The low lasted (0xFFFFFFFF - X) * 16 ns.
; 16 ns is coarse for the shortest pulses (some PS/2 to USB adapters glitch faster than 16 ns).
; Overclocked to 250 MHz with the PIO clock divider at 1, a pass takes 8 ns.
;
; TODO: run this SM in parallel with a glitch detector, synchronized, so that a glitch and its
; time line up.
;
; Autopush on, 32-bit threshold.
; IN pin 0: CLOCK
; JMP pin:  CLOCK
.wrap_target
initialize_counter:
    mov x, !null            ; 00 X = 0xFFFFFFFF, counting down
    wait 1 pin, 0           ; 01 CLOCK high first, so the next wait sees a real falling edge
    wait 0 pin, 0           ; 02 CLOCK low: the falling edge, timing starts
count_loop:
    jmp pin, capture_time   ; 03 Rising edge: stop timing
    jmp x--, count_loop     ; 04 Still low: count one pass
capture_time:
    in x, 32                ; 05 X into the ISR; autopush sends it to the RX FIFO
.wrap

.program fall_counter
; Must run at 125 MHz (8 ns per instruction).
;
; The same as rise_counter for a CLOCK high, from a rising edge to the next falling edge, with
; the same arithmetic and the same TODO.
;
; Autopush on, 32-bit threshold.
; IN pin 0: CLOCK
; JMP pin:  CLOCK
.wrap_target
initialize_counter:
    mov x, !null            ; 00 X = 0xFFFFFFFF, counting down
    wait 0 pin, 0           ; 01 CLOCK low first, so the next wait sees a real rising edge
    wait 1 pin, 0           ; 02 CLOCK high: the rising edge, timing starts
count_loop:
    jmp pin, check_fall     ; 03 CLOCK still high: go count one pass
    jmp capture_time        ; 04 CLOCK low, the falling edge: stop timing
check_fall:
    jmp x--, count_loop     ; 05 Count one pass while CLOCK stays high
capture_time:
    in x, 32                ; 06 X into the ISR; autopush sends it to the RX FIFO
.wrap
