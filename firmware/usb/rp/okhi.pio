; WARNING: BULLSHIT CODE X-)
; ---------------------------------------------------------------------------

;  Two PIO programs capture the USB lines:
;
;      tar_lowsp_pio0, on PIO0, is the sampler. It locks onto the USB bit clock, samples
;      D+ once per bit, detects the start and end of each packet, and streams the raw
;      line samples (still NRZI-encoded and bit-stuffed) to core 0 through the RX FIFO.
;
;      tar_pio1, on PIO1, starts it. It waits for a clean SE0 (both data lines low), then
;      raises START, which releases PIO0, so capture always begins from a known bus state.
;
;  The PIO only recovers bits in real time. Core 1 decodes them afterwards: NRZI, bit
;  de-stuffing, and the SYNC, PID and CRC5/CRC16 checks (process_buffer() and
;  process_packet() in okhi.c).
;
;  Ported to the Raspberry Pi Pico SDK from Alex Taradov's "usb-sniffer-lite":
;      https://github.com/ataradov/usb-sniffer-lite   (BSD-3-Clause)
;  This port captures low speed (1.5 Mbit/s) and full speed (12 Mbit/s) with one program.
;  J and K swap between the two speeds, so usb_speed_set() in usb_speed.h rewrites the
;  two waits on the J line (instructions 1 and 2), moves the JMP pin and changes both
;  clock dividers while the state machines are stopped. At boot usb_speed_init() checks
;  that the program is 32 instructions long at offset 0 with the expected waits at 1 and
;  2; if not, the capture never switches to full speed.
;
;  Protocol references:
;      https://web.archive.org/web/20250415152420/https://www.usbmadesimple.co.uk/
;      https://www.beyondlogic.org/usbnutshell/usb1.shtml
;      USB 2.0 Specification, chapters 7 (electrical) and 8 (protocol)
;
;  USB low speed signalling
;
;  USB is a differential bus on two wires, D+ and D-. The line states at low speed:
;
;      J    D+ low,  D- high   idle
;      K    D+ high, D- low    the other data state
;      SE0  D+ low,  D- low    single-ended zero: an EOP; if it lasts, a bus reset or a
;                              detach
;      SE1  D+ high, D- high   never driven on purpose (USB 2.0 7.1.1); it can appear for
;                              an instant where D+ and D- cross
;
;  At full speed J and K swap: J is D+ high, D- low.
;
;  NRZI: a 0 bit is a transition between J and K, and a 1 bit is no transition. The PIO
;  records the raw D+ level once per bit, and core 1 undoes the NRZI.
;
;  Bit stuffing: the transmitter inserts a 0 (a forced transition) after six 1s in a row,
;  so a receiver always has edges to lock onto. The PIO captures the stuffed bits and
;  core 1 removes them.
;
;  SYNC: every packet starts with KJKJKJKK. Its seven transitions from the idle J give a
;  receiver edges to lock onto, and the final KK (no transition) marks where the PID
;  begins.
;
;  SOP (start of packet): the idle J breaks into the first K of the SYNC. At low speed
;  that first transition drives D- low.
;  EOP (end of packet): two bit times of SE0, then J. The PIO detects the SE0.
;
;  Clocking
;
;  At low speed PIO0 and PIO1 run at 15 MHz: a PIO cycle is 66.67 ns and a 1.5 Mbit/s bit
;  666.67 ns. At full speed they run at 120 MHz (divider 1): 8.33 ns a cycle and 83.33 ns
;  a 12 Mbit/s bit. Either way a bit is 10 PIO cycles, and each sampling loop takes
;  exactly 10 cycles, so the state machine is its own bit clock.
;
;  The RP2040 system clock must be 120 MHz, not the default 125 MHz: both dividers are
;  then integers, 8 and 1, with no jitter. At 125 MHz they would be 8.333 and 1.042, and
;  the fractional divider (/8 and /9, or /1 and /2) would move the sample point by up to
;  one 8 ns system clock: 1.2% of a low speed bit, about a tenth of a full speed one.
;  main() in okhi.c calls set_sys_clock_khz(120000, true).
;
;  FIFO output format
;
;  For every packet PIO0 pushes 32-bit words of two kinds, told apart by bit 31:
;
;      DATA word (bit 31 = 0): up to 31 raw line samples, MSB-first. Autopush at 31 bits
;      keeps bit 31 clear.
;
;      SIZE word (bit 31 = 1): the X counter, seeded with 0xFFFFFFFF and decremented once
;      per sample, so bit 31 stays set. Core 0 takes the bit count as 0xFFFFFFFF - word.
;
;  A packet of N samples comes as N / 31 + 1 DATA words, the last one right-aligned
;  (empty when N is a multiple of 31), then its SIZE word. Core 0 checks every record
;  against that count.
;
;  A sustained SE0 gives a SIZE word of 0xFFFFFFFF (bit count 0) with no DATA word, which
;  core 1 reads as a bus reset. A detach gives the same word, because the host's
;  pull-downs then hold both lines low.
;
;  The PIO counts samples, not time, and core 0 leaves each packet's time slot at 0
;  (okhi.c), so this build records no time between packets.
;
;  Pin mapping
;
;      PIN 0 (IN base)       D+, GPIO DP_INDEX
;      PIN 1 (IN base + 1)   D-, GPIO DM_INDEX
;      PIN 2 (IN base + 2)   START, GPIO START_INDEX, driven by PIO1 for PIO0
;      JMP PIN               D+ at low speed, D- at full speed (usb_speed_set())
;
;  okhi.c sets the IN base to DP_INDEX (sm_config_set_in_pins()), so DP_INDEX, DM_INDEX
;  and START_INDEX must be consecutive GPIOs in that order.
;
;  The ::PINS trick: mov OSR, ::PINS reads the pins bit-reversed, D+ into bit 31 and D-
;  into bit 30. OUT shifts left, from the MSB, so out Y, 2 then takes just those two:
;  Y = {D+, D-}, with START dropped.


; PIO0: the sampler
;
; Set up in okhi.c: RX FIFO joined (8 deep, no TX FIFO); IN shifts left with autopush at
; 31 bits; OUT shifts left with no autopull and a threshold of 32 bits.
;
; The entry point is the last instruction, 31, where usb_speed_start() in usb_speed.h
; jumps with pio_sm_exec(). It waits there for START from PIO1.
;
; After each instruction the RP2040 sets the PC by this rule (datasheet 3.5.2):
;   1. A JMP whose condition is true: PC = its target.
;   2. Else, if PC is EXECCTRL_WRAP_TOP (.wrap): PC = EXECCTRL_WRAP_BOTTOM (.wrap_target).
;   3. Else PC = PC + 1, or 0 if PC was 31.
; The program must be exactly 32 instructions, so that rule 3 takes the entry WAIT at 31
; to idle at 0. Rule 2 is the other way back to idle with no JMP: the .wrap after
; instruction 30, taken only after a sustained SE0 (a bus reset or a detach). After a
; normal EOP, jmp Y-- idle (27) returns there.

.program tar_lowsp_pio0

.wrap_target
idle:
    mov X, !NULL             ; 00 X = 0xFFFFFFFF, the packet's sample counter. It counts
                             ;    down, one per sample, so its top bit stays set and
                             ;    marks the SIZE word.
    wait 1 PIN 1             ; 01 Wait for J, the idle: D- high at low speed. At full
                             ;    speed usb_speed_set() makes it wait 1 PIN 0 (D+).
    wait 0 PIN 1             ; 02 Wait for D- to fall: the J to K edge of SOP, or an SE0
                             ;    (a low speed keep-alive, a reset, a detach), which
                             ;    gives a 1-sample record. Full speed: wait 0 PIN 0.
start0:
    nop [2]                  ; 03 Resync: these 3 cycles put the next sample 5 cycles
                             ;    after the cycle that saw the edge (at 02 or 16-19),
                             ;    near the middle of the bit cell. With 2 cycles the
                             ;    polls at 16-19 sit early: an edge about 1 cycle late
                             ;    misses them, and the bit after it can be read twice.
                             ;    In a cycle model of this program (2026-11-04), 3
                             ;    cycles tolerate 8-10 ns of full speed jitter, 14 ns
                             ;    of D+/D- crossing skew and a low speed device 1.75%
                             ;    slow with key reports (1.25% with all-0xFF data),
                             ;    against 4 ns, 6 ns and 0.5% with 2. A model of the
                             ;    whole capture path replays 46 of 46 analyzer
                             ;    captures exactly with 3 cycles and 13 with 2, with
                             ;    the captures' one-sample SE0 and SE1 at the
                             ;    crossings kept.
read0:
    jmp X-- pio0_label_4     ; 04 Count the sample (X--). The target is the next
                             ;    instruction, so this only decrements X.
pio0_label_4:
    in PINS, 1               ; 05 Shift the raw D+ level into the ISR (autopush every
                             ;    31 bits).
    mov OSR, ::PINS          ; 06 The pins into OSR, bit-reversed: D+ in bit 31, D- in
                             ;    bit 30.
    out Y, 2                 ; 07 Y = {D+, D-}: 0 SE0, 1 J, 2 K, 3 SE1 (at full speed
                             ;    1 is K and 2 is J).
    jmp !Y eop               ; 08 Y == 0: both lines low, SE0, the end of the packet.
    nop [3]                  ; 09 4 cycles. They put the JMP pin test (10) at the end of
                             ;    the loop, 3 to 4 cycles into the next bit cell, where
                             ;    it has to be to see a K to J transition, and keep the
                             ;    loop at 10 cycles, one bit.
    jmp PIN read0            ; 10 The JMP pin, D+ at low speed and D- at full speed, is
                             ;    high in K. Still high (no transition): stay in read0.
                             ;    Low (K to J): fall through into read1.
read1:
    jmp X-- pio0_label_6     ; 11 Count the sample (as 04).
pio0_label_6:
    in PINS, 1               ; 12 Sample D+ into the ISR (as 05).
    mov OSR, ::PINS          ; 13 Bit-reversed pin snapshot (as 06).
    out Y, 2                 ; 14 Y = {D+, D-} (as 07).
    jmp !Y eop               ; 15 SE0: the end of the packet (as 08).
    jmp PIN start0           ; 16 Edge search: 4 polls of the JMP pin, from up to 1 cycle
    jmp PIN start0           ; 17 before the expected J to K edge to 2 or 3 cycles after
    jmp PIN start0           ; 18 it (an earlier edge is caught at the first poll). The
    jmp PIN start0           ; 19 first poll that sees it jumps to start0, whose nop [2]
                             ;    re-centres the sample. The 4 polls absorb the phase
                             ;    drift between the PIO clock and the USB bit clock (a
                             ;    DPLL-style resync).
    jmp read1                ; 20 No edge (still J): read1 again for the next bit.
eop:
    push noblock             ; 21 Push the last DATA word, partial or empty. With the
                             ;    FIFO full, noblock drops the word and the SM runs on.
    mov ISR, X               ; 22 The sample counter into the ISR.
    push noblock             ; 23 Push it: the SIZE word, 0xFFFFFFFF minus the sample
                             ;    count, with bit 31 set.
poll_reset:
    set X, 31                ; 24 Up to 32 polls of the SE0 that ended the packet.
poll_loop:
    mov OSR, ::PINS          ; 25 Bit-reversed pin snapshot (as 06).
    out Y, 2                 ; 26 Y = {D+, D-}.
    jmp Y-- idle             ; 27 Y != 0: the SE0 is over, a normal EOP, back to idle.
                             ;    The decrement of Y is unused.
    jmp X-- poll_loop [5]    ; 28 Still SE0: poll again until X underflows. 32 polls 9
                             ;    cycles apart give the reset marker: about 19 us of
                             ;    SE0 at low speed, 2.4 us at full speed. Without the
                             ;    [5] it is 1.07 us at full speed, under the 1.25 to
                             ;    1.5 us low speed EOP that a hub sends to its full
                             ;    speed ports after a PRE (USB 2.0 11.8.4) and that
                             ;    ends a resume (7.1.7.7), so each of those reads as a
                             ;    bus reset (1495 in 12 s on the test bench, with a
                             ;    low speed mouse behind the keyboard's full speed hub).
                             ;    With polls 9 cycles apart the SM is still back at idle
                             ;    in time for a packet at the 2-bit minimum gap.
    mov ISR, !NULL           ; 29 A sustained SE0: a bus reset, or a detach (the host's
                             ;    pull-downs hold both lines low). 0xFFFFFFFF into the
                             ;    ISR, the reset marker.
    push noblock             ; 30 Push it: bit count 0, which core 1 reads as a bus
                             ;    reset. The .wrap then returns to idle (00), which
                             ;    waits for J.
.wrap
    wait 1 PIN 2             ; 31 Entry point, reached only by the jump in
                             ;    usb_speed_start(). Wait for PIO1 to raise START
                             ;    (PIN 2), then the PC rolls over from 31 to 0 and
                             ;    capture starts at idle, on the clean SE0 PIO1 found.


; PIO1: the START synchroniser
;
; PIO1 only starts PIO0. Once it sees a stable SE0 (both lines low: a reset, a detach or
; the end of a packet), it raises START, which releases PIO0's entry WAIT, so capture
; never begins mid-packet. It reads Y = {D+, D-} as PIO0 does and wants SE0 in four
; samples in a row, 3 cycles apart. The debounce takes 12 cycles, 100 ns at full speed,
; which fits in the 167 ns of a full speed EOP. Then PIO1 spins until usb_speed_start()
; runs it again from its first instruction, at the next speed change.
;
; Set up in okhi.c: the SET pin is START, and the IN base is D+ (PIN 0), so D- is PIN 1
; and START is PIN 2.

.program tar_pio1
    set pindirs, 1           ; 00 START as an output.
    set pins, 0              ; 01 START low: PIO0 stays parked at its entry WAIT.
.wrap_target
    nop [31]                 ; 02 128 cycles (4 x 32) before the first test, so PIO0 has
    nop [31]                 ; 03 reached its entry WAIT before START can rise.
    nop [31]                 ; 04
    nop [31]                 ; 05
wait_se0:
    mov OSR, ::PINS          ; 06 Bit-reversed pin snapshot (sample 1 of 4).
    out Y, 2                 ; 07 Y = {D+, D-}.
    jmp Y-- wait_se0         ; 08 Y != 0, not SE0: start the debounce again.
    mov OSR, ::PINS          ; 09 Sample 2 of 4.
    out Y, 2                 ; 10 Y = {D+, D-}.
    jmp Y-- wait_se0         ; 11 Not SE0: start again.
    mov OSR, ::PINS          ; 12 Sample 3 of 4.
    out Y, 2                 ; 13 Y = {D+, D-}.
    jmp Y-- wait_se0         ; 14 Not SE0: start again.
    mov OSR, ::PINS          ; 15 Sample 4 of 4.
    out Y, 2                 ; 16 Y = {D+, D-}.
    jmp Y-- wait_se0         ; 17 Not SE0: start again. Past here, SE0 held in all four.
    set PINS, 1              ; 18 START high: releases PIO0's entry WAIT on this SE0.
infinite_loop:
    jmp infinite_loop        ; 19 Done: spin here until usb_speed_start() runs PIO1
                             ;    again.
.wrap
